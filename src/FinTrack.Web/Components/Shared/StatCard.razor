<MudPaper Elevation="1" Class="pa-4 d-flex align-center gap-3" Style="height:100%">
    <MudAvatar Color="Color" Variant="Variant.Filled">
        <MudIcon Icon="@Icon" />
    </MudAvatar>
    <div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Title</MudText>
        <MudText Typo="Typo.h5" Class="stat-value">@Money.Format(Value)</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.caption">@Subtitle</MudText>
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public decimal Value { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Insights;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public string? Subtitle { get; set; }
}
