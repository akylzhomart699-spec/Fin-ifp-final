@page "/import"
@inject ICsvImportService Importer
@inject ICategorizationService Categorizer
@inject IAccountService Accounts
@inject ICategoryService Categories
@inject ISnackbar Snackbar

<PageTitle>Import statement — FinTrack</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Import statement</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" md="8">
        <MudPaper Elevation="1" Class="pa-4" Style="height:100%">
            <MudText Typo="Typo.h6" Class="mb-1">1. Choose an account and a file</MudText>
            <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                <b>Kaspi Gold PDF statement</b> — as downloaded from the Kaspi.kz app (Kaspi Gold → Statement).
                Or a CSV with "Date", "Description", "Amount" columns (expenses with a minus sign).
                <MudLink Href="sample-statement.csv" Target="_blank">Download a sample file</MudLink>
            </MudText>

            <MudSelect T="Guid" @bind-Value="_accountId" Label="Account to import into" Class="mb-4"
                       ToStringFunc="AccountName" AnchorOrigin="Origin.BottomCenter">
                @foreach (var a in _accounts)
                {
                    <MudSelectItem T="Guid" Value="@a.Id">@a.Name</MudSelectItem>
                }
            </MudSelect>

            <div class="file-drop">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.body2">Choose a PDF or CSV (up to 10 MB)</MudText>
                <InputFile OnChange="OnFileSelected" accept=".pdf,.csv,application/pdf,text/csv" aria-label="Statement file" />
            </div>

            @if (_parsing)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
            }
            @if (_fatal is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_fatal</MudAlert>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Elevation="1" Class="pa-4" Style="height:100%">
            <div class="d-flex align-center mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Primary" Class="mr-2" />
                <MudText Typo="Typo.h6">ML.NET model</MudText>
            </div>
            @if (Categorizer.IsModelReady)
            {
                <MudText Typo="Typo.body2">Trained: @Categorizer.TrainedAt?.ToString("dd.MM.yyyy HH:mm")</MudText>
                <MudText Typo="Typo.body2">Samples: @Categorizer.TrainingSamples, categories: @Categorizer.LabelsCount</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    The model learns from your transactions. If it is not confident (below @((CategorizationService.MinConfidence * 100).ToString("0"))%),
                    category keywords are used.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">The model is not trained yet — keywords are used.</MudText>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Class="mt-3"
                       OnClick="RetrainAsync" Disabled="_training">
                @(_training ? "Training..." : "Retrain")
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_rows is not null)
{
    <MudPaper Elevation="1" Class="pa-4 mt-4">
        <div class="d-flex align-center flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.h6" Class="flex-grow-1">2. Review transactions</MudText>
            <MudText Typo="Typo.body2">
                Selected: <b>@SelectedCount</b> of @_rows.Count · errors: @(_rows.Count(r => r.Error is not null))
                · duplicates: @(_rows.Count(r => r.IsDuplicate))
            </MudText>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-2" role="group" aria-label="Row selection">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DoneAll"
                       OnClick="() => SetAll(true)">Select all</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RemoveDone"
                       OnClick="() => SetAll(false)">Clear all</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FiberNew"
                       OnClick="SelectNewOnly">New only</MudButton>
        </div>
        @if (_rows.Any(r => r.Include && r.IsDuplicate))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                Selected rows already exist in the database (@(_rows.Count(r => r.Include && r.IsDuplicate))). They will be imported again.
            </MudAlert>
        }

        <MudTable Items="_rows" Dense="true" Hover="true" FixedHeader="true" Virtualize="true" Height="55vh"
                  Breakpoint="Breakpoint.Sm" Elevation="0" T="ImportRow">
            <HeaderContent>
                <MudTh>Import</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Category</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Import">
                    <MudCheckBox T="bool" @bind-Value="context.Include" Disabled="@(context.Error is not null)" Color="Color.Primary" />
                </MudTd>
                <MudTd DataLabel="Date">@context.Date?.ToString("dd.MM.yyyy")</MudTd>
                <MudTd DataLabel="Description">
                    @context.Description
                    @if (context.Error is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">Line @context.Line: @context.Error</MudText>
                    }
                    else if (context.IsDuplicate)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">Looks like a duplicate — already in the database</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Amount"><MoneyText Amount="context.Amount" ShowPlus="true" Colored="true" /></MudTd>
                <MudTd DataLabel="Category">
                    @if (context.Error is null)
                    {
                        <MudSelect T="Guid?" @bind-Value="context.CategoryId" Dense="true" Margin="Margin.Dense"
                                   Variant="Variant.Outlined" ToStringFunc="CategoryName" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var c in _categories.Where(c => c.Type == context.Type))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)c.Id)">@c.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (context.Method is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@MethodText(context)</MudText>
                        }
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="d-flex justify-end flex-wrap gap-2 mt-3">
            <MudButton OnClick="Reset">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                       OnClick="CommitAsync" Disabled="@(_saving || SelectedCount == 0)">
                Import (@SelectedCount)
            </MudButton>
        </div>
    </MudPaper>
}

@code {
    private List<Account> _accounts = new();
    private List<Category> _categories = new();
    private List<ImportRow>? _rows;
    private Guid _accountId;
    private bool _parsing, _saving, _training;
    private string? _fatal;

    private int SelectedCount => _rows?.Count(r => r.Include && r.Error is null && r.CategoryId is not null) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await Accounts.GetAllAsync();
            _categories = await Categories.GetAllAsync();
            _accountId = _accounts.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch (Exception ex)
        {
            _fatal = $"Could not load reference data: {ex.Message}";
        }
    }

    private string AccountName(Guid id) => _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "";
    private string CategoryName(Guid? id) => _categories.FirstOrDefault(c => c.Id == id)?.Name ?? "";

    private static string MethodText(ImportRow row) => row.Method == SuggestionMethods.Ml
        ? $"ML.NET, {row.Confidence * 100:0}%"
        : row.Method ?? "";

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _fatal = null;
        _rows = null;
        var file = e.File;
        if (file.Size > CsvImportService.MaxFileSize)
        {
            _fatal = "The file is larger than 10 MB.";
            return;
        }

        _parsing = true;
        try
        {
            await using var stream = file.OpenReadStream(CsvImportService.MaxFileSize);
            var parsed = await Importer.ParseAsync(stream, file.Name);
            if (parsed.FatalError is not null)
            {
                _fatal = parsed.FatalError;
                return;
            }
            await Importer.PrepareAsync(parsed.Rows);
            _rows = parsed.Rows;
        }
        catch (Exception ex)
        {
            _fatal = $"Could not read the file: {ex.Message}";
        }
        finally
        {
            _parsing = false;
        }
    }

    private async Task CommitAsync()
    {
        if (_rows is null) return;
        _saving = true;
        var result = await Importer.CommitAsync(_rows, _accountId);
        _saving = false;

        if (result.Ok)
        {
            Snackbar.Add($"Transactions imported: {result.Count}. The model is retraining in the background.", Severity.Success);
            _rows = null;
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }

    private async Task RetrainAsync()
    {
        _training = true;
        await Categorizer.TrainAsync();
        _training = false;
        Snackbar.Add(Categorizer.IsModelReady ? "Model retrained" : "Could not train the model", Categorizer.IsModelReady ? Severity.Success : Severity.Warning);
    }

    /// <summary>Select or clear all rows without errors.</summary>
    private void SetAll(bool include)
    {
        if (_rows is null) return;
        foreach (var row in _rows.Where(r => r.Error is null)) row.Include = include;
    }

    /// <summary>Select only rows that are not yet in the database.</summary>
    private void SelectNewOnly()
    {
        if (_rows is null) return;
        foreach (var row in _rows.Where(r => r.Error is null)) row.Include = !row.IsDuplicate;
    }

    private void Reset()
    {
        _rows = null;
        _fatal = null;
    }
}
