@inject IAccountService Accounts

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField T="string" @bind-Value="_name" Label="Название" Required="true" RequiredError="Введите название"
                          MaxLength="100" AutoFocus="true" HelperText="Например: Kaspi Gold, Наличные, Депозит" />
            <MudNumericField T="decimal" @bind-Value="_initial" Label="Начальный остаток, ₸" Class="mt-3" />
        </MudForm>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Account? Existing { get; set; }

    private MudForm _form = default!;
    private string _name = "";
    private decimal _initial;
    private bool _saving;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Existing is null) return;
        _name = Existing.Name;
        _initial = Existing.InitialBalance;
    }

    private async Task SaveAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        var result = await Accounts.SaveAsync(new Account
        {
            Id = Existing?.Id ?? Guid.NewGuid(),
            Name = _name,
            InitialBalance = _initial,
        });
        _saving = false;

        if (result.Ok) MudDialog.Close(DialogResult.Ok(true));
        else _error = result.Error;
    }

    private void Cancel() => MudDialog.Cancel();
}
